---
# Prefer actionable correctness checks over blanket style/modernisation rules.
# Use a clang-tidy version that understands the compiler's C++23 mode and SDK.
Checks: >-
  -*,
  clang-analyzer-core.*,
  clang-analyzer-cplusplus.*,
  clang-analyzer-deadcode.*,
  bugprone-assert-side-effect,
  bugprone-dangling-handle,
  bugprone-infinite-loop,
  bugprone-integer-division,
  bugprone-macro-parentheses,
  bugprone-macro-repeated-side-effects,
  bugprone-misplaced-widening-cast,
  bugprone-multiple-statement-macro,
  bugprone-narrowing-conversions,
  bugprone-sizeof-container,
  bugprone-sizeof-expression,
  bugprone-string-constructor,
  bugprone-string-integer-assignment,
  bugprone-stringview-nullptr,
  bugprone-suspicious-memset-usage,
  bugprone-suspicious-semicolon,
  bugprone-suspicious-string-compare,
  bugprone-too-small-loop-variable,
  bugprone-use-after-move,
  performance-*,
  modernize-use-nullptr,
  modernize-use-override,
  readability-braces-around-statements,
  readability-misleading-indentation,
  readability-redundant-smartptr-get
# Enabled diagnostics must be resolved or narrowly justified before publication.
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|/)(include/fastregex|src/compiler)/'
SystemHeaders: false
FormatStyle: file
CheckOptions:
  readability-braces-around-statements.ShortStatementLines: '0'
...
